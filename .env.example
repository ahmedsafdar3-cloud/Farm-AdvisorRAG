# Copy this file to .env and fill in your key.
#
# RECOMMENDED (free, no credit card): Groq
# 1. Go to https://console.groq.com/keys
# 2. Sign up, click "Create API Key"
# 3. Paste it below
GROQ_API_KEY=your_groq_key_here

# OPTIONAL alternative (paid, requires billing credit): Anthropic
# Only needed if you want to use Claude instead of the free Groq/Llama option.
# ANTHROPIC_API_KEY=your_anthropic_key_here
